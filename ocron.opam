bug-reports: "https://github.com/whereistejas/ocron/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml"
  "base"
  "sexplib"
  "ppx_sexp_conv"
  "ppx_compare"
  "ppx_deriving"
